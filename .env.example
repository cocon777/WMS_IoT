# Copy to .env and generate independent random values. No real credentials here.
JWT_SECRET=
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_ADMIN_USERNAME=wms-admin
MQTT_ADMIN_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Use only letters and numbers for MYSQL_PASSWORD in this scaffold's connection URL.
MYSQL_PASSWORD=
HTTPS_PORT=8443
MQTT_TLS_PORT=18883
WS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
LOGIN_IP_MAX_ATTEMPTS=60
LOGIN_IP_WINDOW_S=60
# Must match the actual trusted nginx Docker network; never trust all Internet peers.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
